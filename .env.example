# =============================================================================
# MCP-Linx — пример переменных окружения (C4)
#
# Использование:
#   cp .env.example .env
#   `.env` в .gitignore; `.env.example` — в репозитории (см. .gitignore:27-29).
#
# `Settings` (src/mcp_linx/main.py:36, pydantic-settings) читает файл `.env`
# из текущего каталога. ВАЖНО (A10): env_prefix у `Settings` НЕТ, поэтому
# имена вида LINX_* НЕ маппятся на поля — используйте имена ниже.
# Регистр имён не важен (pydantic-settings сопоставляет case-insensitive).
# =============================================================================

# --- Settings: поля, которые реально читаются кодом (6) ----------------------

# Имя сервера, объявляется MCP-клиентам (main.py:123)
MCP_SERVER_NAME=mcp-linx

# Версия сервера (main.py:124)
MCP_SERVER_VERSION=1.0.0

# Путь к конфигу; переопределяет дефолт `config/settings.yaml` (main.py:109)
CONFIG_PATH=config/settings.yaml

# Уровень логирования: DEBUG | INFO | WARNING | ERROR (main.py:49)
LOG_LEVEL=INFO

# Harness-цикл: default | streaming (main.py:128)
AGENT_LOOP=default

# `PLUGINS` НЕ поддерживается (A10, FIXED 2026-09-17): поле `Settings.plugins`
# удалено как мёртвое — состав плагинов задаёт только
# `config/settings.yaml::plugins.enabled` (PluginManager.load_plugins()).

# --- Секреты плагинов: `${VAR}`-подстановка в config/settings.yaml (A4) ------
# Значения раскрываются при загрузке конфига (`load_config` → `_expand_env_vars`),
# поддерживается форма `${VAR:-default}`. Если переменная не задана и default
# отсутствует — предупреждение в лог, «сырой» текст остаётся (fail-open, A4).
#
# В settings.yaml используются ровно эти имена:

# POSTGRES_PASSWORD=            # plugins.postgres.password  (settings.yaml:114)
# REDIS_PASSWORD=               # plugins.redis.password     (settings.yaml:133)
# PROMETHEUS_TOKEN=             # plugins.prometheus.token   (settings.yaml:168)
# LOKI_TOKEN=                   # plugins.loki.token         (settings.yaml:174)

# --- docker-compose.yml (только для Docker-профиля) --------------------------

# Каталог с SSH-ключами к целевым хостам; монтируется в /home/mcp/.ssh:ro
# (интерполяция docker compose, НЕ читается Python-кодом). Дефолт: ~/.ssh
# SSH_KEY_DIR=~/.ssh